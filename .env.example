# Copy to .env and fill in. Never commit .env.

# --- Telegram --------------------------------------------------------------
# From @BotFather. Privacy mode must be OFF, or the bot must be a group admin,
# otherwise it will not see messages from other members.
TELEGRAM_BOT_TOKEN=
# Comma-separated numeric Telegram user IDs allowed to use the bot.
# Anything from anyone else is ignored silently.
TELEGRAM_ALLOWED_USER_IDS=
# The single group chat the bot operates in.
TELEGRAM_CHAT_ID=

# --- LLM (OpenRouter) ------------------------------------------------------
OPENROUTER_API_KEY=
# Model per modality. Chosen with evals/, not by intuition.
MODEL_TEXT=
MODEL_VOICE=
MODEL_VISION=
# Comma-separated fallbacks used when the primary errors or rate-limits.
MODEL_FALLBACKS=

# --- Database --------------------------------------------------------------
POSTGRES_USER=finbot
POSTGRES_PASSWORD=
POSTGRES_DB=finbot
DATABASE_URL=postgresql+asyncpg://finbot:@postgres:5432/finbot

# --- Behaviour -------------------------------------------------------------
TIMEZONE=Europe/Kyiv
DEFAULT_CURRENCY=UAH
# Voice notes longer than this are rejected with an explanation.
MAX_VOICE_SECONDS=120
