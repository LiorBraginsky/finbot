# Copy to .env and fill in. Never commit .env.

# --- Telegram --------------------------------------------------------------
# From @BotFather. Privacy mode must be OFF, or the bot must be a group admin,
# otherwise it will not see messages from other members.
TELEGRAM_BOT_TOKEN=
# Comma-separated numeric Telegram user IDs allowed to use the bot.
# Anything from anyone else is ignored silently.
TELEGRAM_ALLOWED_USER_IDS=
# The single group chat the bot operates in.
TELEGRAM_CHAT_ID=

# --- LLM (OpenRouter) ------------------------------------------------------
OPENROUTER_API_KEY=
# Rarely needs changing; override only for a local proxy or test double.
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Model per modality. Chosen with evals/, not by intuition. No ":free" id is
# accepted — worst data policy, hard rate limits (Settings rejects it at
# startup).
MODEL_TEXT=
MODEL_VOICE=
MODEL_VISION=
# Comma-separated fallbacks used when the primary errors or rate-limits.
MODEL_FALLBACKS=
# Per-HTTP-call timeout for the OpenRouter client.
LLM_TIMEOUT_SECONDS=60
# Repair-loop attempts within one processing round (spec §4.3: at most two).
MAX_EXTRACTION_ATTEMPTS=2
# Processing rounds for one message before it is marked permanently failed.
MAX_MESSAGE_ATTEMPTS=5

# --- Database --------------------------------------------------------------
POSTGRES_USER=finbot
# URL-safe characters only (alphanumerics, -, _, .): compose interpolates this
# unescaped into DATABASE_URL below, and other characters (@, %, :, /, ...)
# corrupt the URL silently rather than failing loudly. Generate one with:
# openssl rand -hex 32
POSTGRES_PASSWORD=
POSTGRES_DB=finbot
# No DATABASE_URL here on purpose: infra/docker-compose.yml builds it for the
# bot service from the three variables above (environment: takes precedence
# over env_file), so there is exactly one place to set the password. A
# DATABASE_URL added here would be a second, driftable copy of the same
# secret and is exactly how the bot ends up unable to authenticate.

# --- Behaviour -------------------------------------------------------------
TIMEZONE=Europe/Kyiv
DEFAULT_CURRENCY=UAH
# Voice notes longer than this are rejected with an explanation.
MAX_VOICE_SECONDS=120
